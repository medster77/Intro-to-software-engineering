<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fillWidth="true" prefHeight="678.0" prefWidth="642.0" spacing="12.0" style="-fx-background-color: #212121; -fx-background-radius: 15; -fx-border-color: #3A3A3A; -fx-border-width: 2; -fx-border-radius: 15;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.todolistapp.TodoListController">
   <children>

      <HBox fx:id="titleBar" alignment="CENTER_RIGHT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="48.0" spacing="4.0" style="-fx-background-color: #171717; -fx-background-radius: 13 13 0 0;">
         <padding>
            <Insets bottom="0.0" left="14.0" right="10.0" top="0.0" />
         </padding>
         <children>
            <TextField fx:id="titleField" alignment="CENTER_LEFT" onAction="#onTitleEntered" prefHeight="32.0" promptText="Enter ToDo list name..." style="-fx-background-color: #2F2F2F; -fx-background-radius: 8; -fx-text-fill: #ECECEC; -fx-prompt-text-fill: #8E8EA0; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0 10 0 10; -fx-highlight-fill: #10A37F;" HBox.hgrow="ALWAYS" />
            <Button fx:id="minButton" mnemonicParsing="false" onAction="#onMinimize" prefHeight="32.0" prefWidth="34.0" style="-fx-background-color: transparent; -fx-text-fill: #B4B4B4; -fx-font-size: 13px; -fx-cursor: hand;" text="—" />
            <Button fx:id="maxButton" mnemonicParsing="false" onAction="#onMaximize" prefHeight="32.0" prefWidth="34.0" style="-fx-background-color: transparent; -fx-text-fill: #B4B4B4; -fx-font-size: 13px; -fx-cursor: hand;" text="☐" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onClose" prefHeight="32.0" prefWidth="34.0" style="-fx-background-color: transparent; -fx-text-fill: #F07178; -fx-font-size: 13px; -fx-cursor: hand;" text="✕" />
         </children>
      </HBox>

      <!-- Add task row -->
      <HBox alignment="CENTER" prefHeight="38.0">
         <padding>
            <Insets bottom="0.0" left="16.0" right="16.0" top="0.0" />
         </padding>
         <children>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAddTask" prefHeight="38.0" prefWidth="44.0" style="-fx-background-color: #10A37F; -fx-background-radius: 10 0 0 10; -fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-cursor: hand;" text="+" />
            <Label alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="38.0" prefWidth="522.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 0; -fx-text-fill: #8E8EA0; -fx-font-size: 14px; -fx-padding: 0 12 0 12;" text="Press + to add a new task" HBox.hgrow="ALWAYS" />
            <Button fx:id="completedButton" mnemonicParsing="false" onAction="#onShowCompleted" prefHeight="38.0" prefWidth="44.0" style="-fx-background-color: #2F2F2F; -fx-background-radius: 0 10 10 0; -fx-text-fill: #10A37F; -fx-font-size: 18px; -fx-cursor: hand;" text="✓">
               <tooltip>
                  <Tooltip text="View completed tasks" />
               </tooltip>
            </Button>
         </children>
      </HBox>

      <!-- Ruled area: 21 lines, same as the original -->
      <VBox fx:id="taskList" prefHeight="546.0" style="-fx-background-color: #1B1B1B; -fx-background-radius: 10; -fx-border-color: #303030; -fx-border-width: 1; -fx-border-radius: 10;">
         <VBox.margin>
            <Insets bottom="16.0" left="16.0" right="16.0" top="0.0" />
         </VBox.margin>
         <children>
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
            <HBox prefHeight="26.0" style="-fx-border-color: transparent transparent #2C2C2C transparent; -fx-border-width: 0 0 1 0;" />
         </children>
      </VBox>
   </children>
</VBox>
