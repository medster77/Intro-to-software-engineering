<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox centerShape="false" fillWidth="false" prefHeight="390.0"
      prefWidth="383.0" spacing="20.0" style="-fx-background-color: #212121; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: transparent;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.todolistapp.TodoListController">
   <children>
      <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="382.0" onMousePressed="#onTitleBarPressed" onMouseDragged="#onTitleBarDragged">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <Button fx:id="minButton" onAction="#onMinimize" mnemonicParsing="false" prefHeight="30.0" prefWidth="29.0" style="-fx-background-color: Transparent;" text="—" textFill="WHITE" />
            <Button fx:id="maxButton" onAction="#onMaximize" mnemonicParsing="false" prefHeight="30.0" prefWidth="31.0" style="-fx-background-color: Transparent;" text="☐" textFill="WHITE" />
            <Button fx:id="closeButton" onAction="#onClose" mnemonicParsing="false" prefHeight="30.0" prefWidth="29.0" style="-fx-background-color: Transparent;" text="✕" textFill="RED">
               <font>
                  <Font name="Brougham Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TextField alignment="TOP_LEFT" prefHeight="26.0" prefWidth="135.0" promptText="Enter ToDo list name..." style="-fx-pref-width: 140;" VBox.vgrow="NEVER">
         <font>
            <Font name="Arial" size="12.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </TextField>
   </children>
</VBox>
