<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox centerShape="false" fillWidth="false" prefHeight="411.0" prefWidth="385.0" spacing="20.0" style="-fx-background-color: #212121; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.todolistapp.TodoListController">
   <children>
      <HBox fx:id="titleBar" alignment="CENTER_RIGHT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="30.0" prefWidth="382.0">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <TextField alignment="TOP_LEFT" prefHeight="26.0" prefWidth="282.0" promptText="Enter ToDo list name...">
               <font>
                  <Font name="Arial" size="12.0" />
               </font>
            </TextField>
            <Button fx:id="minButton" mnemonicParsing="false" onAction="#onMinimize" prefHeight="30.0" prefWidth="29.0" style="-fx-background-color: Transparent;" text="—" textFill="WHITE" />
            <Button fx:id="maxButton" mnemonicParsing="false" onAction="#onMaximize" prefHeight="30.0" prefWidth="31.0" style="-fx-background-color: Transparent;" text="☐" textFill="WHITE" />
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onClose" prefHeight="30.0" prefWidth="29.0" style="-fx-background-color: Transparent;" text="✕" textFill="RED">
               <font>
                  <Font name="Brougham Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <HBox alignment="TOP_RIGHT" prefHeight="30.0" prefWidth="378.0">
         <children>
            <Button alignment="TOP_RIGHT" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" prefHeight="26.0" prefWidth="25.0" text="+" textAlignment="CENTER" textFill="RED" />
         </children>
      </HBox>
      <AnchorPane prefHeight="94.0" prefWidth="382.0" />
   </children>
</VBox>
