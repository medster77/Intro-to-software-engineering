<VBox alignment="CENTER" centerShape="false" prefHeight="390.0" prefWidth="383.0" spacing="20.0" style="-fx-background-color: #212121; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.todolistapp.TodoListController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" style="-fx-background-color: grey; -fx-border-radius: 15;" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />
</VBox>
